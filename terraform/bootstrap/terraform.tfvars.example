# Copiar a terraform.tfvars y reemplazar con los valores reales.

# Claim sub del token OIDC de GitHub para la rama main.
github_sub = "repo:mi-usuario@12345678/mi-repo@987654321:ref:refs/heads/main"

# Perfil de AWS CLI que asume el rol local de despliegue.
profile = "mi-perfil"

# Region donde se desplegaran los recursos de AWS
region = "us-east-2" 