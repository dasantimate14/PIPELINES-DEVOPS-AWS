# Copiar a terraform.tfvars solo si necesitas cambiar los valores por defecto.
# Todas las variables tienen default, asi que este archivo es opcional.

proyecto = "devops-final"
region   = "us-east-1"
vpc_cidr = "10.0.0.0/16"

# true = endpoints en ambas zonas (mas disponibilidad, doble costo de endpoints).
endpoints_en_todas_las_zonas = false
